MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker
ACCESS_TOKEN_SECRET=replace-with-a-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret
CLIENT_URL=http://localhost:3001
PORT=3000
NODE_ENV=development

# Password reset email (optional; sign-in works without these).
# Set a verified sender and your public frontend base URL.
PASSWORD_RESET_URL=http://localhost:3001
MAIL_FROM=
RESEND_API_KEY=

# Alternative SMTP transport, for hosting plans that support SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
